// The store as a Spore UI: GPUI lays out the shopfront, wasi:webgpu renders it,
// and soil:present hands the texture to the presenter. The catalog comes from
// the host's installed-Spore list and the remote store over soil:http.
package fungos:store-view@0.2.0;

world runner {
  include wasi:webgpu/imports@0.3.0-rc.2;
  import soil:present/surface@0.1.0;
  import soil:spore/catalog@0.1.0;
  import soil:http/http@0.1.0;

  export run: async func() -> u32;
}
