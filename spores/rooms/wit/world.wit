// Rooms Spore: rooms, membership and admission live here, in records.
// The host maps the `rooms` namespace to a book and enforces the grant; the
// renderer is Canvas, which never sees a room rule.
package fungos:rooms@0.1.0;

world rooms {
  import soil:records/records@0.1.0;
  import soil:mic/capture@1.0.0;
  import soil:voice/session@0.1.0;
  import wasi:audio/playback@0.1.0;

  export run: func(args: list<string>) -> result<_, string>;
}
